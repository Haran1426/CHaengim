<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="챙김 · 다가오는 일정" android:textColor="#E0EEAC" android:textSize="12sp" android:fontFamily="@font/paperlogy_semibold" />
        <TextView android:id="@+id/widget_add" android:layout_width="36dp" android:layout_height="32dp" android:gravity="center" android:text="+" android:textSize="24sp" android:textColor="#E0EEAC" android:background="@drawable/widget_add_background" android:contentDescription="새 일정 추가" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_one" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingVertical="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/title_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="가장 먼저 챙길 일정" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/paperlogy_semibold" />
            <TextView android:id="@+id/info_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="준비물 2개 남음 · 준비 중" android:textColor="#C3D4C9" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/day_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="D-3" android:textColor="#E0EEAC" android:textSize="21sp" android:fontFamily="@font/paperlogy_semibold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_two" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingVertical="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/title_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="다음으로 챙길 일정" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/paperlogy_semibold" />
            <TextView android:id="@+id/info_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="준비물 1개 남음 · 결과 대기" android:textColor="#C3D4C9" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/day_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="D-7" android:textColor="#E0EEAC" android:textSize="21sp" android:fontFamily="@font/paperlogy_semibold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_three" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingVertical="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/title_three" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="미리 준비할 일정" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/paperlogy_semibold" />
            <TextView android:id="@+id/info_three" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="준비물 3개 남음 · 준비 중" android:textColor="#C3D4C9" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/day_three" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="D-12" android:textColor="#E0EEAC" android:textSize="21sp" android:fontFamily="@font/paperlogy_semibold" />
    </LinearLayout>
</LinearLayout>
